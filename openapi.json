  "components": {
    "securitySchemes": {
      "ApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    },
    "schemas": {
      "Product": {
        "type": "object",
        "minProperties": 1,
        "maxProperties": 100,
        "propertyNames": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "additionalProperties": {
          "type": "string",
          "maxLength": 32000
        },
        "example": {
          "id": "demo-1",
          "title": " Canvas bag ",
          "price": "29.00 USD",
          "availability": "in_stock"
        }
      },
      "SingleRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "product",
          "processing_consent"
        ],
        "properties": {
          "country": {
            "type": "string",
            "enum": [
              "US",
              "GB"
            ],
            "default": "US"
          },
          "processing_consent": {
            "type": "boolean",
            "const": true
          },
          "product": {
            "$ref": "#/components/schemas/Product"
          }
        }
      },
      "BatchRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "products",
          "processing_consent"
        ],
        "properties": {
          "country": {
            "type": "string",
            "enum": [
              "US",
              "GB"
            ],
            "default": "US"
          },
          "processing_consent": {
            "type": "boolean",
            "const": true
          },
          "products": {
            "type": "array",
            "minItems": 1,
            "maxItems": 25,
            "items": {
              "$ref": "#/components/schemas/Product"
            }
          }
        }
      },
      "FeedRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "filename",
          "data_base64",
          "processing_consent"
        ],
        "properties": {
          "country": {
            "type": "string",
            "enum": [
              "US",
              "GB"
            ],
            "default": "US"
          },
          "processing_consent": {
            "type": "boolean",
            "const": true
          },
          "filename": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          },
          "data_base64": {
            "type": "string",
            "contentEncoding": "base64"
          }
        }
      },
      "Meta": {
        "type": "object",
        "required": [
          "request_id",
          "api_version"
        ],
        "properties": {
          "request_id": {
            "type": "string"
          },
          "api_version": {
            "type": "string"
          },
          "google_approval_verified": {
            "const": false
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error",
          "meta"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          },
          "meta": {
            "$ref": "#/components/schemas/Meta"
          }
        }
      },
      "Success": {
        "type": "object",
        "required": [
          "data",
          "meta"
        ],
        "properties": {
          "data": {
            "type": "object"
          },
          "meta": {
            "$ref": "#/components/schemas/Meta"
          }
        }
      },
      "Finding": {
        "type": "object",
        "required": [
          "code",
          "attribute",
          "severity",
          "message",
          "auto_fix"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "attribute": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "error",
              "warning",
              "review"
            ]
          },
          "message": {
            "type": "string"
          },
          "auto_fix": {
            "type": "boolean"
          },
          "row": {
            "type": [
              "integer",
              "null"
            ]
          },
          "sku": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        }
      },
      "Proposal": {
        "type": "object",
        "required": [
          "id",
          "before",
          "after",
          "reason",
          "attribute"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "before": {
            "type": "string"
          },
          "after": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "attribute": {
            "type": "string"
          },
          "sku": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        }
      },
      "Diagnostics": {
        "type": "object",
        "properties": {
          "issues": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Finding"
            }
          },
          "proposals": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Proposal"
            }
          },
          "error_products": {
            "type": "integer"
          }
        }
      },
      "ValidationResponse": {
        "type": "object",
        "required": [
          "data",
          "meta"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Diagnostics"
          },
          "meta": {
            "$ref": "#/components/schemas/Meta"
          }
        }
      }
    }
  },
  "x-feedrescue-plans": {
    "free": {
      "usd": 0,
      "requests": 100,
      "products": 500,
      "rpm": 10,
      "batch": 25
    }
  },
  "x-max-body-bytes": 8388608
}
